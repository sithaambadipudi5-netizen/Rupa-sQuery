{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development DISABLE_HMR=true tsx server.ts",
    "build": "vite build && esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "postinstall": "node -e \"try { if(require('fs').existsSync('server/app.ts') && !require('fs').existsSync('dist/server.cjs')){ console.log('Building dist in install phase...'); require('child_process').execSync('npm run build', {stdio:'inherit'}); } } catch(e){ console.log('Postinstall build skipped:', e.message); }\"",
    "start": "node server.ts",
    "start:bundle": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "~5.8.2"
  }
}
